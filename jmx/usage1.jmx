<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="usage1">
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
    </TestPlan>
    <hashTree>
      <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="protocol" elementType="Argument">
            <stringProp name="Argument.name">protocol</stringProp>
            <stringProp name="Argument.value">http</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="fqdn" elementType="Argument">
            <stringProp name="Argument.name">fqdn</stringProp>
            <stringProp name="Argument.value">${__P(fqdn,kiwix.hotspot)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">Hotspot FQDN (kiwix.hotspot usually)</stringProp>
          </elementProp>
          <elementProp name="port" elementType="Argument">
            <stringProp name="Argument.name">port</stringProp>
            <stringProp name="Argument.value">${__P(port,80)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="nb_users" elementType="Argument">
            <stringProp name="Argument.name">nb_users</stringProp>
            <stringProp name="Argument.value">${__P(nb_users,1)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">Nb of users to fake (see ifnames.csv CSV Data Set)</stringProp>
          </elementProp>
          <elementProp name="dns_server" elementType="Argument">
            <stringProp name="Argument.name">dns_server</stringProp>
            <stringProp name="Argument.value">${__P(dns_server,192.168.2.1)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">DNS server to use (Hotspot IP)</stringProp>
          </elementProp>
          <elementProp name="kiwix_domain" elementType="Argument">
            <stringProp name="Argument.name">kiwix_domain</stringProp>
            <stringProp name="Argument.value">${__P(kiwix_domain,browse)}</stringProp>
            <stringProp name="Argument.desc">Subdomain of kiwix instance (browse)</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="assume_online" elementType="Argument">
            <stringProp name="Argument.name">assume_online</stringProp>
            <stringProp name="Argument.value">${__P(assume_online,false)}</stringProp>
            <stringProp name="Argument.desc">Whether target Hotspot is assumed to be online or not</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="content_id" elementType="Argument">
            <stringProp name="Argument.name">content_id</stringProp>
            <stringProp name="Argument.value">${__P(content_id,openzim_wikipedia_en_top_nopic)}</stringProp>
            <stringProp name="Argument.desc">Hotspot ident for content to query</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="video_content_id" elementType="Argument">
            <stringProp name="Argument.name">video_content_id</stringProp>
            <stringProp name="Argument.value">${__P(video_content_id,mali-pour-les-nuls_fr_all)}</stringProp>
            <stringProp name="Argument.desc">Hotspot ident for content containing videos (must be youtube2zim made)</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="nb_parallel_reqs" elementType="Argument">
            <stringProp name="Argument.name">nb_parallel_reqs</stringProp>
            <stringProp name="Argument.value">${__P(nb_parallel_reqs,6)}</stringProp>
            <stringProp name="Argument.desc">Nb of parallel HTTP requests (typical web browser is 6)</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="nb_pages_per_user" elementType="Argument">
            <stringProp name="Argument.name">nb_pages_per_user</stringProp>
            <stringProp name="Argument.value">${__P(nb_pages_per_user,20)}</stringProp>
            <stringProp name="Argument.desc">Nb of pages (articles) a user reads for text users</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="read_min_ms" elementType="Argument">
            <stringProp name="Argument.name">read_min_ms</stringProp>
            <stringProp name="Argument.value">${__P(read_min_ms,1000)}</stringProp>
            <stringProp name="Argument.desc">Minimum article/page “read” duration (part of random). In milliseconds</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="read_max_ms" elementType="Argument">
            <stringProp name="Argument.name">read_max_ms</stringProp>
            <stringProp name="Argument.value">${__P(read_max_ms,60000)}</stringProp>
            <stringProp name="Argument.desc">Maximum article/page “read” duration (part of random). In milliseconds</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="nb_videos_per_user" elementType="Argument">
            <stringProp name="Argument.name">nb_videos_per_user</stringProp>
            <stringProp name="Argument.value">${__P(nb_videos_per_user,3)}</stringProp>
            <stringProp name="Argument.desc">Nb of videos to stream for video users</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="stream_min_seconds" elementType="Argument">
            <stringProp name="Argument.name">stream_min_seconds</stringProp>
            <stringProp name="Argument.value">${__P(stream_min_seconds,5)}</stringProp>
            <stringProp name="Argument.desc">Minimum playing duration (part of random). In seconds</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="stream_max_seconds" elementType="Argument">
            <stringProp name="Argument.name">stream_max_seconds</stringProp>
            <stringProp name="Argument.value">${__P(stream_max_seconds,180)}</stringProp>
            <stringProp name="Argument.desc">Maximum playing duration (part of random). In seconds</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="search_min_ms" elementType="Argument">
            <stringProp name="Argument.name">search_min_ms</stringProp>
            <stringProp name="Argument.value">${__P(search_min_ms,1000)}</stringProp>
            <stringProp name="Argument.desc">Minimum duration (part of random) inside search result page. In milliseconds</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="search_max_ms" elementType="Argument">
            <stringProp name="Argument.name">search_max_ms</stringProp>
            <stringProp name="Argument.value">${__P(search_max_ms,10000)}</stringProp>
            <stringProp name="Argument.desc">Maximum duration (part of random) inside search result page. In milliseconds</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="actions" elementType="Argument">
            <stringProp name="Argument.name">actions</stringProp>
            <stringProp name="Argument.value">read|suggest|search</stringProp>
            <stringProp name="Argument.desc">Possible actions for user</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="action_read" elementType="Argument">
            <stringProp name="Argument.name">action_read</stringProp>
            <stringProp name="Argument.value">read</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="action_suggest" elementType="Argument">
            <stringProp name="Argument.name">action_suggest</stringProp>
            <stringProp name="Argument.value">suggest</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="action_search" elementType="Argument">
            <stringProp name="Argument.name">action_search</stringProp>
            <stringProp name="Argument.value">search</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="nb_suggestion_attempts" elementType="Argument">
            <stringProp name="Argument.name">nb_suggestion_attempts</stringProp>
            <stringProp name="Argument.value">${__P(nb_suggestion_attempts,3)}</stringProp>
            <stringProp name="Argument.desc">Nb of terms to query suggestion for when testing suggestions</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </Arguments>
      <hashTree/>
      <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="CSV Data Set Config">
        <stringProp name="filename">ifnames.csv</stringProp>
        <stringProp name="fileEncoding"></stringProp>
        <stringProp name="variableNames"></stringProp>
        <boolProp name="ignoreFirstLine">true</boolProp>
        <stringProp name="delimiter">,</stringProp>
        <boolProp name="quotedData">false</boolProp>
        <boolProp name="recycle">true</boolProp>
        <boolProp name="stopThread">false</boolProp>
        <stringProp name="shareMode">shareMode.all</stringProp>
      </CSVDataSet>
      <hashTree/>
      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="HTTP Request Defaults" enabled="true">
        <boolProp name="HTTPSampler.concurrentDwn">true</boolProp>
        <stringProp name="HTTPSampler.concurrentPool">${nb_parallel_reqs}</stringProp>
        <stringProp name="HTTPSampler.ipSource">${ifname}</stringProp>
        <stringProp name="HTTPSampler.domain">${fqdn}</stringProp>
        <stringProp name="HTTPSampler.port">${port}</stringProp>
