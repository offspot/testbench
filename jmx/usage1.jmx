          </HTTPSamplerProxy>
          <hashTree>
            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract playlist ID" enabled="true">
              <stringProp name="JSONPostProcessor.referenceNames">extracted_first_playlist_slug</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">firstPlaylist</stringProp>
