            <hashTree/>
          </hashTree>
          <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="Set playlist ID extracted data">
            <stringProp name="BeanShellSampler.query">vars.put(&quot;first_playlist_slug&quot;, vars.get(&quot;extracted_first_playlist_slug&quot;));
</stringProp>
          </BeanShellSampler>
          <hashTree/>
          <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="Loop on videos">
            <stringProp name="LoopController.loops">${nb_videos_per_user}</stringProp>
